[Unit]
Description=Reconcile pending Mercado Pago orders
After=network.target postgresql.service

[Service]
Type=oneshot
User=galeria
Group=galeria
WorkingDirectory=/srv/galeria/current
EnvironmentFile=/srv/galeria/.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env pnpm payments:reconcile
