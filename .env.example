# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Galeria"
NEXT_PUBLIC_PHOTOGRAPHER="Galeria"
NEXT_PUBLIC_INSTAGRAM="https://instagram.com/"
CONTACT_EMAIL="contato@example.com"

# Auth - generate with: openssl rand -base64 48
AUTH_SECRET="dev-only-change-me-please-0000000000000000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# Database. Leave empty for embedded PGlite in dev.
DATABASE_URL=""
# Absolute app root for relative storage/PGlite paths (systemd sets this).
# APP_ROOT="/srv/galeria/current"

# Storage: local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# Payments: Mercado Pago Checkout API (Pix, cartão, boleto)
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
PAYMENTS_MOCK="true"

# Email (Resend). Empty = log to console.
RESEND_API_KEY=""
EMAIL_FROM="Galeria <no-reply@example.com>"

# Uploads
MAX_UPLOAD_MB="95"
